.next
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store
.DS_Store
dist
coverage
*.tsbuildinfo
.vercel

# Local environment overrides — never commit secrets (e.g. the
# FRONTEND_ACCESS_* values used for local testing live here).
.env*.local

# Claude Code workspace artifacts
.agents/
.claude/skills/*
# ...except project skills that are shared deliberately.
!.claude/skills/financials-v2/
.claude/worktrees/
skills-lock.json
supabase/.temp/

# Capacitor iOS shell — the source-of-truth files (App.xcodeproj,
# AppDelegate.swift, Info.plist, capacitor-cordova-ios-plugins, etc.)
# get committed in PR #14b after `npx cap add ios`. These entries
# are pre-emptive ignores for build artifacts, dependency caches, and
# user-specific Xcode state that should never enter version control.
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/DerivedData/
ios/.sourcemaps/
# Note: ios/App/Podfile.lock IS committed (locks Pod versions for
# reproducible builds, same role as package-lock.json).
# Note: out/ is the webDir placeholder; out/index.html IS committed
# (one tiny fallback file used only when the WebView can't reach
# server.url on cold start). Other contents stay ignored.
out/*
!out/index.html
