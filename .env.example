NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# ── Front-end-only access (shared public-site login) ───────────────
# One shared email + password that lets a non-member view ONLY the
# public marketing site (never the member portal, dashboard, or any
# backend). Checked server-side in /api/frontend-access; on a match the
# server issues a signed, HTTP-only cookie. These are SERVER-ONLY — do
# not prefix with NEXT_PUBLIC_ and do not commit real values. Set them
# in Vercel (Project → Settings → Environment Variables). Leave unset to
# disable the feature entirely (member login is unaffected).
# COOKIE_SECRET should be a long random string (e.g. `openssl rand -hex 32`).
FRONTEND_ACCESS_EMAIL=
FRONTEND_ACCESS_PASSWORD=
FRONTEND_ACCESS_COOKIE_SECRET=


# ── Stripe (the only payment provider — Financials V2) ─────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_...
STRIPE_SECRET_KEY=sk_test_or_sk_live_...


# ── Financials V2 checkout interlock ───────────────────────────────
# Session creation (and any recovery that could mint a payable Session)
# is refused unless this is exactly "true". It never selects a read
# source: figures stay visible while checkout is paused, and recovery
# cleanup keeps running. Leave unset to keep checkout closed.
FINANCE_V2_CHECKOUT_READY=
