NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# ── Payment provider flag ──────────────────────────────────────────
# 'stripe' (default) keeps the existing Stripe Checkout path on
# /portal/journey/payment. 'square' routes the journey-contribution
# Pay button through the new Square sandbox/production flow. The
# onboarding donation, gift donate, and /pay/[token] surfaces stay
# on Stripe regardless of this flag (separate migrations).
PAYMENT_PROVIDER=stripe

# ── Stripe (dormant once PAYMENT_PROVIDER=square) ──────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_...
STRIPE_SECRET_KEY=sk_test_or_sk_live_...

# ── Square ─────────────────────────────────────────────────────────
# Get these from Square Developer Dashboard. Sandbox values for
# preview/staging; live values for production. Webhook signature key
# is the one shown after creating a webhook subscription.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=EAAA...
SQUARE_LOCATION_ID=L...
SQUARE_WEBHOOK_SIGNATURE_KEY=
